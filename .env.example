# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database
OPENWEATHER_API_KEY=replace-me

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayFast
NEXT_PUBLIC_PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=replace-me
PAYFAST_MERCHANT_KEY=replace-me
PAYFAST_PASSPHRASE=replace-me

# Upstash rate limiting
UPSTASH_REDIS_REST_URL=replace-me
UPSTASH_REDIS_REST_TOKEN=replace-me
